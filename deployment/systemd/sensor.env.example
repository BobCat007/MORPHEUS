# Use the HTTPS URL of the collector, not its internal localhost URL.
MORPHEUS_COLLECTOR_URL=https://collector.example.org

MORPHEUS_SENSOR_ID=site-a
MORPHEUS_SENSOR_TOKEN_FILE=/etc/morpheus/sensor.token

# Adjust this path to the actual Cowrie JSON log on the sensor host.
MORPHEUS_COWRIE_LOG=/home/ubuntu/morpheus/deployment/cowrie/var/log/cowrie/cowrie.json

MORPHEUS_SENSOR_QUEUE=/var/lib/morpheus/sensor-queue.jsonl
MORPHEUS_SENSOR_START_AT_END=true
MORPHEUS_SENSOR_HEARTBEAT_INTERVAL=30
MORPHEUS_SENSOR_POLL_INTERVAL=5
MORPHEUS_COWRIE_LOG_POLL_INTERVAL=0.25
