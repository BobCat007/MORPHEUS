[Unit]
Description=MORPHEUS API Collector
After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/morpheus
EnvironmentFile=/etc/morpheus/api.env
Environment=PYTHONUNBUFFERED=1
UMask=0077

ExecStart=/home/ubuntu/morpheus/.venv/bin/uvicorn api.app:app --host 127.0.0.1 --port 8000 --workers 1

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/home/ubuntu/morpheus/data

[Install]
WantedBy=multi-user.target
