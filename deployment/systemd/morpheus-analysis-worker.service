[Unit]
Description=MORPHEUS Central Sensor Analysis Worker
After=network.target morpheus-api.service
Wants=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/morpheus
EnvironmentFile=/etc/morpheus/api.env
Environment=PYTHONUNBUFFERED=1
Environment=MORPHEUS_ANALYSIS_POLL_INTERVAL=2
UMask=0077

ExecStart=/home/ubuntu/morpheus/.venv/bin/python -m telemetry.sensor.analysis_worker

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/home/ubuntu/morpheus/data

[Install]
WantedBy=multi-user.target
